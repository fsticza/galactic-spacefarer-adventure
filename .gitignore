# Dependencies
node_modules/
app/*/node_modules/

# UI5 tooling lockfiles under app/: nothing installs them — CI and the MTA build
# run `npm ci` at the root only, and the Fiori app is served through `cds watch`.
app/*/package-lock.json

# CAP build output and local databases
gen/
*.sqlite
*.sqlite-journal
mta_archives/
resources/

# Generated from the CDS model by cds-typer: run `npm run generate-types`
@cds-models/

# Environment and secrets
.env
default-env.json

# Editors and OS
.DS_Store
*.log
